APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# MediaMTX / CCTV streaming
# Base HLS dari media server, mis. http://192.168.1.10:8888 (kosong = preview kamera tidak tampil)
CCTV_HLS_BASE=
# Control API MediaMTX, mis. http://192.168.1.10:9997 (kosong = sinkronisasi path dinonaktifkan)
CCTV_MEDIAMTX_API=
CCTV_MEDIAMTX_USER=
CCTV_MEDIAMTX_PASS=
# Alamat RTSP MediaMTX untuk path turunan (kamera dengan RTSP URL sama)
CCTV_MEDIAMTX_RTSP=rtsp://127.0.0.1:8554
# Base URL WebRTC/WHEP media server, mis. http://192.168.1.10:8889 (kosong = hanya HLS)
CCTV_WEBRTC_BASE=http://127.0.0.1:8889
# Path / nama binary ffprobe untuk health check
CCTV_FFPROBE=ffprobe
CCTV_PROBE_TIMEOUT=8

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (kosong = push notification nonaktif)
FCM_SERVER_KEY=

# Sanctum: mobile memakai token Bearer. Kosongkan keduanya kecuali auth cookie
# browser diaktifkan (SANCTUM_STATEFUL_DOMAINS = domain cookie, token prefix opsional).
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
