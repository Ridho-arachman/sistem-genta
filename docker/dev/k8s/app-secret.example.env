# Salin ke app-secret.env lalu isi nilai asli. File app-secret.env tidak di-commit.
APP_KEY=
APP_DEBUG=true
APP_ENV=local
APP_URL=http://localhost:8000
DB_PASSWORD=genta_local_password
FCM_SERVER_KEY=

# URL berikut dipakai browser lewat kubectl port-forward (lihat docker/README.md).
CCTV_HLS_BASE=http://127.0.0.1:8888
CCTV_WEBRTC_BASE=http://127.0.0.1:8889

MAIL_USERNAME=
MAIL_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
