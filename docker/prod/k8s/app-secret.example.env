# Salin ke app-secret.env lalu isi nilai asli. File app-secret.env tidak di-commit.
APP_KEY=
APP_DEBUG=false
APP_ENV=production
APP_URL=https://genta.example.com
DB_PASSWORD=ganti_dengan_password_produksi
FCM_SERVER_KEY=

# Ganti dengan host/media server produksi yang bisa dijangkau browser.
CCTV_HLS_BASE=https://cctv.example.com:8888
CCTV_WEBRTC_BASE=https://cctv.example.com:8889

MAIL_USERNAME=
MAIL_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
